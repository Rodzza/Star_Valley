# Copie para .env.production e preencha. NÃO envie o .env.production para repositório público.
# Unidade de anúncio PREMIADO criada no AdMob (formato ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY)
VITE_ADMOB_REWARDED_ID=
# ID do APP no AdMob (formato ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY), usado por tools/configureAndroid.mjs
ADMOB_APP_ID=
# Chave pública ANDROID do RevenueCat (Project settings › API keys), começa com goog_
# Sem ela, o app usa compras simuladas.
VITE_REVENUECAT_ANDROID_KEY=
